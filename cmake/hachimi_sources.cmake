# Source manifest is also consumed by the standalone Linux Makefile.
get_filename_component(HACHIMI_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
file(STRINGS "${CMAKE_CURRENT_LIST_DIR}/hachimi_runtime_sources.list" HACHIMI_SOURCE_LINES)
set(HACHIMI_RUNTIME_SOURCES)
foreach(source IN LISTS HACHIMI_SOURCE_LINES)
    if(NOT source MATCHES "^#" AND NOT source STREQUAL "")
        list(APPEND HACHIMI_RUNTIME_SOURCES "${HACHIMI_ROOT}/${source}")
    endif()
endforeach()

function(hachimi_add_runtime target job_backend led_backend lvgl_target)
    add_library(${target} STATIC ${HACHIMI_RUNTIME_SOURCES} "${job_backend}" "${led_backend}")
    target_include_directories(${target} PUBLIC "${HACHIMI_ROOT}" "${HACHIMI_ROOT}/platform/lvgl/src")
    target_link_libraries(${target} PUBLIC ${lvgl_target} m)
    if(WIN32)
        target_link_libraries(${target} PUBLIC winhttp)
    else()
        find_package(Threads REQUIRED)
        target_link_libraries(${target} PUBLIC Threads::Threads ${CMAKE_DL_LIBS})
    endif()
    if(CMAKE_C_COMPILER_ID MATCHES "GNU|Clang")
        target_compile_options(${target} PRIVATE -Wall -Wextra -Wno-unused-parameter)
    endif()
endfunction()
